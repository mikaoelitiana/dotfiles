function __mcp_secret_export -a service var
    set -q $var; and return
    command -q security; or return
    set -l value (security find-generic-password -s $service -a mikaoelitiana -w 2>/dev/null)
    test -n "$value"; and set -gx $var $value
end

{{ with dig "dokploy" "url" "" . -}}
set -gx DOKPLOY_URL {{ . | quote }}
{{ end -}}
__mcp_secret_export dokploy DOKPLOY_API_KEY
__mcp_secret_export playwright-mcp PLAYWRIGHT_MCP_EXTENSION_TOKEN

functions --erase __mcp_secret_export
