{{- /* keyring aborts the template when an item is absent, so probe via security(1) */ -}}
{{- $dokployUrl := dig "dokploy" "url" "" . -}}
{{- $dokployKey := "" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $dokployKey = output "sh" "-c" "security find-generic-password -s dokploy -a mikaoelitiana -w 2>/dev/null || true" | trim -}}
{{- end -}}
{{- $dokployEnabled := and (ne $dokployUrl "") (ne $dokployKey "") -}}
{
   "$schema": "https://opencode.ai/config.json",
   "model": "amazon-bedrock/anthropic.claude-opus-4-8",
   "theme": "catppuccin",
   "autoupdate": true,
   "permission": "allow",
   "mcp": {
     "notion": {
       "type": "remote",
       "url": "https://mcp.notion.com/mcp",
       "enabled": false
     },
     "chrome-devtools": {
       "type": "local",
       "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
       "enabled": false
     },
     "playwright": {
       "type": "local",
       "command": ["npx", "-y", "@playwright/mcp@latest", "--extension"],
       "enabled": false,
       "environment": {
         "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "{env:PLAYWRIGHT_MCP_EXTENSION_TOKEN}"
       }
     },
    "dokploy": {
      "type": "local",
      "command": ["npx", "-y", "@dokploy/mcp"],
      "enabled": {{ $dokployEnabled }},
      "environment": {
        "DOKPLOY_URL": "{env:DOKPLOY_URL}",
        "DOKPLOY_API_KEY": "{env:DOKPLOY_API_KEY}"
      }
    },
    "open-pencil": {
      "enabled": false,
      "command": "openpencil-mcp"
    },
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server",
        "--context=ide",
        "--project-from-cwd"
      ],
      "enabled": true
    }
   },
   "provider": {
      "lmstudio": {
        "name": "LM Studio",
        "npm": "@ai-sdk/openai-compatible",
        "options": {
          "baseURL": "http://127.0.0.1:1234/v1"
        },
        "models": {
          "gemma-4-12b": {
            "_launch": false,
            "name": "google/gemma-4-12b"
          },
          "gemma-4-26b-a4b-qat": {
            "_launch": false,
            "name": "google/gemma-4-26b-a4b-qat"
          }
        }
      },
      "ollama-cloud": {
       "npm": "@ai-sdk/openai-compatible",
       "name": "Ollama Cloud",
       "options": {
         "baseURL": "https://ollama.com/v1"
       },
       "models": {
         "glm-4.7:cloud": {
           "name": "glm-4.7:cloud"
         },
         "gemma4:31b-cloud": {
           "name": "gemma4:31b-cloud"
         }
       }
     }
   }
 }
