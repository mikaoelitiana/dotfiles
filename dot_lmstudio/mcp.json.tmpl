{{- /* keyring aborts the template when an item is absent, so probe via security(1) */ -}}
{{- $playwrightToken := "" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $playwrightToken = output "sh" "-c" "security find-generic-password -s playwright-mcp -a mikaoelitiana -w 2>/dev/null || true" | trim -}}
{{- end -}}
{
  "mcpServers": {
    "notion": {
       "type": "remote",
       "url": "https://mcp.notion.com/mcp",
       "enabled": false
     },
     "chrome-devtools": {
       "type": "local",
       "command": "npx",
       "args": ["-y", "chrome-devtools-mcp@latest"],
       "enabled": false
     },
     "playwright": {
       "type": "local",
       "command": "npx",
       "args": ["-y", "@playwright/mcp@latest", "--extension"],
       "enabled": false,
       "environment": {
         "PLAYWRIGHT_MCP_EXTENSION_TOKEN": {{ $playwrightToken | quote }}
       }
     },
    "open-pencil": {
      "command": "openpencil-mcp"
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {{ keyring "github" "mikaoelitiana" }}"
      }
    }
  }
}
